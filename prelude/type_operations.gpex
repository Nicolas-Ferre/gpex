/// Returns the type of a `value`.
///
/// # Examples
///
/// ```gpex
/// var value = 1;
/// const ValueType = typeof(value); // i32
/// ```
pub const fn typeof(value: ?) -> typeref = intrinsic;

/// Returns the size of a `type_` in bytes.
///
/// # Examples
///
/// ```gpex
/// const I32_SIZE = sizeof(i32); // 4u
/// ```
pub const fn sizeof(type_: const typeref) -> u32 = intrinsic;
