// Test prelude function calls at `const`-time (must be transpiled correctly).

const _I32_SIZE = i32.sizeof(); // expected: 4u
const _U32_SIZE = u32.sizeof(); // expected: 4u
const _F32_SIZE = f32.sizeof(); // expected: 4u
const _BOOL_SIZE = bool.sizeof(); // expected: 4u
const _TYPEREF_SIZE = typeref.sizeof(); // expected: 8u

const _I32_LITERAL_TYPE = 1.typeof(); // expected: i32
const _TYPE_REF_TYPE = i32.typeof(); // expected: typeref
var runtime_value = 2u;
const _RUNTIME_VALUE_TYPE = runtime_value.typeof(); // expected: u32

const _I32_ADD = 2 + 1; // expected: 3
const _I32_ADD_OVERFLOW = 2_147_483_647 + 1; // expected: -2147483648
