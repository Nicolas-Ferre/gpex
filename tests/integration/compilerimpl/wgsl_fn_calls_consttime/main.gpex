// Test prelude function calls at `const`-time (must be transpiled correctly).

const _I32_SIZE = sizeof(i32); // expected: 4u
const _U32_SIZE = sizeof(u32); // expected: 4u
const _F32_SIZE = sizeof(f32); // expected: 4u
const _BOOL_SIZE = sizeof(bool); // expected: 4u
const _TYPEREF_SIZE = sizeof(typeref); // expected: 8u

const _I32_ADD = 2 + 1; // expected: 3
const _I32_ADD_OVERFLOW = 2_147_483_647 + 1; // expected: -2147483648
