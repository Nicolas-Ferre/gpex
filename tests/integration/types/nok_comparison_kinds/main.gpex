// Test type comparison for all possible tye kinds (must generate errors).

// ====================| Returned type reference as type parameter |====================

fn _fn_type_ref_type_param(param: const typeref) -> param {
    return i32;
}

// ====================| Returned type parameter as other type parameter |====================

fn _fn_type_param_type_param(param1: const typeref, param2: const typeref, value: param1) -> param2 {
    return value;
}

// ====================| Returned type parameter as type reference |====================

fn _fn_type_param_type_ref(param: const typeref, value: param) -> i32 {
    return value;
}

// ====================| Returned type parameter through function as type reference |====================

fn _fn_type_param_thought_fn_type_ref(param: const typeref, value: type_param_fn(param)) -> i32 {
    return value;
}
const fn type_param_fn(other_name: const typeref) -> typeref {
    return other_name;
}

// ====================| Returned wildcard type as type reference |====================

fn _fn_wildcard_type_ref(value: ?) -> i32 {
    return value;
}

// ====================| Assigned type reference as wildcard type |====================

fn _fn_type_ref_wildcard(target: ?, value: i32) {
    target = value;
}

// ====================| Returned wildcard type as type parameter |====================

fn _fn_wildcard_type_param(type_: const typeref, value: ?) -> type_ {
    return value;
}

// ====================| Assigned type parameter as wildcard type |====================

fn _fn_type_param_wildcard(type_: const typeref, target: ?, value: type_) {
    target = value;
}

// ====================| Assigned wildcard type as other wildcard type |====================

fn _fn_wildcard_other_wildcard(target: ?, value: ?) {
    target = value;
}
