// Test not found source for all locations (must generate errors).
// This also ensures that validation in general is performed for all locations
// (so no need to exhaustively test all locations for other nok_* tests).

// =========================| Global variable default value |=========================

var _var = error;

// =========================| Global constant value |=========================

const _CONST = error;

// =========================| Repeat call |=========================

repeat error();

// =========================| Function parameter type |=========================

fn _fn(param: error) -> i32 {
    return 0;
}

// =========================| Function return type |=========================

fn _fn() -> error {
    return 0;
}

// =========================| Return statement value |=========================

fn _fn() -> i32 {
    return error;
}

// =========================| Assignment statement left value |=========================

fn _fn() {
    error = 0;
}

// =========================| Assignment statement right value |=========================

fn _fn(param: i32) {
    param = error;
}

// =========================| Call argument |=========================

var _call = call(error);

// =========================| Unary operator operand |=========================

var _neg = -error;
var _not = !error;
