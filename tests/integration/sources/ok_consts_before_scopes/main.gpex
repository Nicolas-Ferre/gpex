// Test constant sources before all possible scopes (must be found).

const SOURCE = i32;
const REQUIREMENT = true;

// =========================| Global |=========================

var _result_global = SOURCE; // expected: i32

// =========================| Function body |=========================

var _result_fn_body = fn_body(); // expected: i32
fn fn_body() -> typeref {
    return SOURCE;
}

// =========================| Function parameter type |=========================

var _result_fn_param_type = fn_param_type(1); // expected: 1
fn fn_param_type(param: SOURCE) -> i32 {
    return param;
}

// =========================| Function parameter requirement |=========================

var _result_fn_param_requirement = fn_param_requirement(2); // expected: 2
fn fn_param_requirement(param: i32 require REQUIREMENT) -> i32 {
    return param;
}

// =========================| Function return type |=========================

var _result_fn_return_type = fn_return_type(3); // expected: 3
fn fn_return_type(param: i32) -> SOURCE {
    return param;
}
