var two = 2.0;
var three = 3.0;
var negative_seven = -7.0;

var _add = two + 3.0; // expected: 5.0
var _sub = two - 3.0; // expected: -1.0
var _mul = -three * two; // expected: -6.0
var _div = negative_seven / two; // expected: -3.5
var _mod = negative_seven % two; // expected: -1.0
var _eq_true = two == 2.0; // expected: true
var _eq_false = two == three; // expected: false
var _ne_true = two != three; // expected: true
var _ne_false = two != 2.0; // expected: false
var _lt_true = two < three; // expected: true
var _lt_false = three < two; // expected: false
var _le_true = two <= 2.0; // expected: true
var _le_false = three <= two; // expected: false
var _gt_true = three > two; // expected: true
var _gt_false = two > three; // expected: false
var _ge_true = two >= 2.0; // expected: true
var _ge_false = two >= three; // expected: false
var _neg = -two; // expected: -2.0
