const _U32_ADD = 2u + 3u; // expected: 5u
const _U32_SUB = 3u - 2u; // expected: 1u
const _U32_MUL = 3u * 2u; // expected: 6u
const _U32_DIV = 7u / 2u; // expected: 3u
const _U32_MOD = 7u % 2u; // expected: 1u
const _U32_EQ = 2u == 2u; // expected: true
const _U32_NE = 2u != 3u; // expected: true
const _U32_LT = 2u < 3u; // expected: true
const _U32_LE = 2u <= 2u; // expected: true
const _U32_GT = 3u > 2u; // expected: true
const _U32_GE = 2u >= 2u; // expected: true
const _U32_ADD_WRAP = 4_294_967_295u + 1u; // expected: 0u
const _U32_SUB_WRAP = 0u - 1u; // expected: 4294967295u
const _U32_MUL_WRAP = 2_147_483_648u * 2u; // expected: 0u
const _U32_DIV_ZERO = 7u / 0u; // expected: 7u
const _U32_MOD_ZERO = 7u % 0u; // expected: 7u
