const _ADD = 2u + 3u; // expected: 5u
const _SUB = 3u - 2u; // expected: 1u
const _MUL = 3u * 2u; // expected: 6u
const _DIV = 7u / 2u; // expected: 3u
const _MOD = 7u % 2u; // expected: 1u
const _EQ_TRUE = 2u == 2u; // expected: true
const _EQ_FALSE = 2u == 3u; // expected: false
const _NE_TRUE = 2u != 3u; // expected: true
const _NE_FALSE = 2u != 2u; // expected: false
const _LT_TRUE = 2u < 3u; // expected: true
const _LT_FALSE = 3u < 2u; // expected: false
const _LE_TRUE = 2u <= 2u; // expected: true
const _LE_FALSE = 3u <= 2u; // expected: false
const _GT_TRUE = 3u > 2u; // expected: true
const _GT_FALSE = 2u > 3u; // expected: false
const _GE_TRUE = 2u >= 2u; // expected: true
const _GE_FALSE = 2u >= 3u; // expected: false
const _ADD_WRAP = 4_294_967_295u + 1u; // expected: 0u
const _SUB_WRAP = 0u - 1u; // expected: 4294967295u
const _MUL_WRAP = 2_147_483_648u * 2u; // expected: 0u
const _DIV_ZERO = 7u / 0u; // expected: 7u
const _MOD_ZERO = 7u % 0u; // expected: 7u
