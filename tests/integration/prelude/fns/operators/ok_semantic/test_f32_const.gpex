const _F32_ADD = 2.0 + 3.0; // expected: 5.0
const _F32_SUB = 2.0 - 3.0; // expected: -1.0
const _F32_MUL = -3.0 * 2.0; // expected: -6.0
const _F32_DIV = -7.0 / 2.0; // expected: -3.5
const _F32_MOD = -7.0 % 2.0; // expected: -1.0
const _F32_EQ = 2.0 == 2.0; // expected: true
const _F32_NE = 2.0 != 3.0; // expected: true
const _F32_LT = 2.0 < 3.0; // expected: true
const _F32_LE = 2.0 <= 2.0; // expected: true
const _F32_GT = 3.0 > 2.0; // expected: true
const _F32_GE = 2.0 >= 2.0; // expected: true
const _F32_NEG = -2.0; // expected: -2.0
