const TWO = 2.0;

const _ADD = 2.0 + 3.0; // expected: 5.0
const _SUB = 2.0 - 3.0; // expected: -1.0
const _MUL = -3.0 * 2.0; // expected: -6.0
const _DIV = -7.0 / 2.0; // expected: -3.5
const _DIV_ZERO = -7.0 / 0.0; // expected: -7.0
const _EQ_TRUE = 2.0 == 2.0; // expected: true
const _EQ_FALSE = 2.0 == 3.0; // expected: false
const _NE_TRUE = 2.0 != 3.0; // expected: true
const _NE_FALSE = 2.0 != 2.0; // expected: false
const _LT_TRUE = 2.0 < 3.0; // expected: true
const _LT_FALSE = 3.0 < 2.0; // expected: false
const _LE_TRUE = 2.0 <= 2.0; // expected: true
const _LE_FALSE = 3.0 <= 2.0; // expected: false
const _GT_TRUE = 3.0 > 2.0; // expected: true
const _GT_FALSE = 2.0 > 3.0; // expected: false
const _GE_TRUE = 2.0 >= 2.0; // expected: true
const _GE_FALSE = 2.0 >= 3.0; // expected: false
const _NEG = -TWO; // expected: -2.0
