// Test public items named with underscore prefix (must generate warnings).
// Item usage is also tested to ensure only one warning is generated.

// =========================| Global constant |=========================

pub const _CONST = 0;

pub const _CONST_USED = 0;
var _const_usage = _CONST_USED;

// =========================| Global variable |=========================

pub var _var = 0;

pub var _var_used = 0;
var _var_usage = _var_used;

// =========================| Function |=========================

pub fn _fn() -> i32 { return 0; }

pub fn _fn_used() -> i32 { return 0; }
var _fn_usage = _fn_used();
