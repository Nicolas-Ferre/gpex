// INIT SHADER

struct Buffer {
    v5: i32,
    v6: f32,
    v7: u32
}

@group(0) @binding(0)
var<storage, read_write> b: Buffer;

@compute @workgroup_size(1, 1, 1)
fn main() {
    b.v7 = u32(3);
    b.v6 = f32(2.0);
    b.v5 = i32(1);
}


// UPDATE SHADER

struct Buffer {
    v5: i32,
    v6: f32,
    v7: u32
}

@group(0) @binding(0)
var<storage, read_write> b: Buffer;

@compute @workgroup_size(1, 1, 1)
fn main() {

}

