// Test all expression forms that are not allowed in reference locations (must generate errors).
// The functions containing reference locations are used in other function signature
// to test constant calculation behavior in case of reference check error.

// =========================| Literal |=========================

const fn literals_as_ref() -> typeref {
    false = true;
    true = false;
    1.0 = 0.0;
    1 = 0;
    1u = 0u;
    return i32;
}
fn _calculate_literals_as_ref() -> literals_as_ref() {
    return 0;
}

// =========================| Type reference |=========================

const fn types_as_ref() -> typeref {
    i32 = u32;
    return i32;
}
fn _calculate_types_as_ref() -> types_as_ref() {
    return 0;
}

// =========================| Global constant |=========================

const CONST = 0;
const fn global_consts_as_ref() -> typeref {
    CONST = 0;
    return i32;
}
fn _calculate_global_consts_as_ref() -> global_consts_as_ref() {
    return 0;
}

// =========================| Function call |=========================

const fn fn_calls_as_ref() -> typeref {
    called_fn() = 0;
    return i32;
}
const fn called_fn() -> i32 {
    return 0;
}
fn _calculate_fn_calls_as_ref() -> fn_calls_as_ref() {
    return 0;
}

// =========================| Unary operator |=========================

const fn unary_as_ref() -> typeref {
    !0 = 0;
    return i32;
}
const fn __not__(param: i32) -> i32 {
    return param;
}
fn _calculate_unary_as_ref() -> unary_as_ref() {
    return 0;
}

// =========================| Binary operator |=========================

const fn binary_as_ref() -> typeref {
    true + false = false;
    return i32;
}
const fn __add__(param1: bool, _param2: bool) -> bool {
    return param1;
}
fn _calculate_binary_as_ref() -> binary_as_ref() {
    return 0;
}
