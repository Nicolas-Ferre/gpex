// Test binary operator priority (must be correctly calculated).

fn __add__(_param1: i32, _param2: i32) -> i32 {
    return 1;
}
fn __sub__(_param1: i32, _param2: i32) -> i32 {
    return 2;
}
fn __mul__(_param1: i32, _param2: i32) -> i32 {
    return 3;
}
fn __div__(_param1: i32, _param2: i32) -> i32 {
    return 4;
}
fn __mod__(_param1: i32, _param2: i32) -> i32 {
    return 5;
}
fn __eq__(_param1: i32, _param2: i32) -> i32 {
    return 6;
}
fn __ne__(_param1: i32, _param2: i32) -> i32 {
    return 7;
}
fn __lt__(_param1: i32, _param2: i32) -> i32 {
    return 8;
}
fn __le__(_param1: i32, _param2: i32) -> i32 {
    return 9;
}
fn __gt__(_param1: i32, _param2: i32) -> i32 {
    return 10;
}
fn __ge__(_param1: i32, _param2: i32) -> i32 {
    return 11;
}
fn __and__(_param1: i32, _param2: i32) -> i32 {
    return 12;
}
fn __or__(_param1: i32, _param2: i32) -> i32 {
    return 13;
}

fn __add__(_param1: bool, _param2: bool) -> bool {
    return true;
}

fn __mul__(_param1: bool, _param2: bool) -> bool {
    return false;
}

var _chain = true + false * true; // expected: true

// =========================| `+` first |=========================

var _add_add = 1 + 2 + 3; // expected: 1
var _add_sub = 1 + 2 - 3; // expected: 2
var _add_mul = 1 + 2 * 3; // expected: 1
var _add_div = 1 + 2 / 3; // expected: 1
var _add_mod = 1 + 2 % 3; // expected: 1
var _add_eq = 1 + 2 == 3; // expected: 6
var _add_ne = 1 + 2 != 3; // expected: 7
var _add_lt = 1 + 2 < 3; // expected: 8
var _add_le = 1 + 2 <= 3; // expected: 9
var _add_gt = 1 + 2 > 3; // expected: 10
var _add_ge = 1 + 2 >= 3; // expected: 11
var _add_and = 1 + 2 && 3; // expected: 12
var _add_or = 1 + 2 || 3; // expected: 13

// =========================| `-` first |=========================

var _sub_add = 1 - 2 + 3; // expected: 1
var _sub_sub = 1 - 2 - 3; // expected: 2
var _sub_mul = 1 - 2 * 3; // expected: 2
var _sub_div = 1 - 2 / 3; // expected: 2
var _sub_mod = 1 - 2 % 3; // expected: 2
var _sub_eq = 1 - 2 == 3; // expected: 6
var _sub_ne = 1 - 2 != 3; // expected: 7
var _sub_lt = 1 - 2 < 3; // expected: 8
var _sub_le = 1 - 2 <= 3; // expected: 9
var _sub_gt = 1 - 2 > 3; // expected: 10
var _sub_ge = 1 - 2 >= 3; // expected: 11
var _sub_and = 1 - 2 && 3; // expected: 12
var _sub_or = 1 - 2 || 3; // expected: 13

