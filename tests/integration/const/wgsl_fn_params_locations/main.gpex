// Test parameters in all constant locations (must be transpiled inline).


// =========================| Function signature |=========================

const _RESULT1_FN_SIGNATURE = fn_signature(i32, 1); // expected: 1
const _RESULT2_FN_SIGNATURE = fn_signature(u32, 2u); // expected: 2u
const fn fn_signature(param: const typeref, value: param) -> param {
    return value;
}

// =========================| Function call in function signature |=========================

const _RESULT1_FN_CALL_IN_FN_SIGNATURE = fn_call_in_fn_signature(i32, 3); // expected: 3
const _RESULT2_FN_CALL_IN_FN_SIGNATURE = fn_call_in_fn_signature(u32, 4u); // expected: 4u
const fn fn_call_in_fn_signature(param: const typeref, value: fn_signature_type(param)) -> fn_signature_type(param) {
    return value;
}
const fn fn_signature_type(param: const typeref) -> typeref {
    return param;
}

// =========================| Function parameter requirement |=========================

const _RESULT_PARAM_REQUIREMENT = fn_param_requirement(true); // expected: true
const fn fn_param_requirement(param: const bool require param) -> bool {
    return param;
}

// =========================| Return statement value |=========================

const _RESULT_RETURN = fn_with_return(1); // expected: 1
const fn fn_with_return(param: i32) -> i32 {
    return param;
}

// =========================| Assignment statement left value |=========================

const _RESULT_ASSIGNMENT_LEFT = fn_with_assignment_left(0); // expected: 2
const fn fn_with_assignment_left(param: i32) -> i32 {
    param = 2;
    return param;
}

// =========================| Assignment statement right value |=========================

const _RESULT_ASSIGNMENT_RIGHT = fn_with_assignment_right(0, 3); // expected: 3
const fn fn_with_assignment_right(param1: i32, param2: i32) -> i32 {
    param1 = param2;
    return param2;
}

// =========================| Function call argument |=========================

const _RESULT_FN_ARG = fn_with_returned_call_arg(4); // expected: 4
const fn fn_with_returned_call_arg(param: i32) -> i32 {
    return called_fn(param);
}
const fn called_fn(param: i32) -> i32 {
    return param;
}

// =========================| Unary operator operand |=========================

const _RESULT_UNARY = fn_with_returned_unary(5); // expected: 5
const fn fn_with_returned_unary(param: i32) -> i32 {
    return -param;
}
const fn __neg__(param: i32) -> i32 {
    return param;
}

// =========================| Binary operator left operand |=========================

const _RESULT_BINARY_LEFT = fn_with_returned_binary_left(5); // expected: 5
const fn fn_with_returned_binary_left(param: i32) -> i32 {
    return param + 0;
}
const fn __add__(param1: i32, _param2: i32) -> i32 {
    return param1;
}

// =========================| Binary operator right operand |=========================

const _RESULT_BINARY_RIGHT = fn_with_returned_binary_right(6); // expected: 6
const fn fn_with_returned_binary_right(param: i32) -> i32 {
    return 0u + param;
}
const fn __add__(_param1: u32, param2: i32) -> i32 {
    return param2;
}
