// Test not constant expressions in all constant locations (must generate errors).

var not_const_value = 0;
const fn called_const_fn(param: i32) -> i32 {
    return param;
}
const fn __neg__(param: i32) -> i32 {
    return param;
}
const fn __add__(param1: i32, _param2: i32) -> i32 {
    return param1;
}

// =========================| Global constant value |=========================

const _CONST = not_const_value;

// =========================| Function parameter type |=========================

fn _fn_param_type(param: not_const_value) -> i32 {
    return param;
}

// =========================| Function return type |=========================

fn _fn_return_type(param: i32) -> not_const_value {
    return param;
}

// =========================| Return statement value |=========================

const fn _fn_return() -> i32 {
    return not_const_value;
}

// =========================| Assignment statement left value |=========================

const fn _fn_assignment_left(){
    not_const_value = 0;
}

// =========================| Assignment statement right value |=========================

const fn _fn_assignment_right(param: i32) {
    param = not_const_value;
}

// =========================| Function call argument |=========================

const _FN_CALL_ARG_CONST_CONTEXT = called_const_fn(not_const_value);

// =========================| Constant function call argument |=========================

var _result_const_call_arg = const_param(0, not_const_value, 0);
fn const_param(_param1: const i32, param2: const i32, _param3: const i32) -> i32 {
    return param2;
}

// =========================| Constant function call argument with non-constant parameter |=========================

const fn outer_fn_call_arg_non_const_context(param: i32) -> i32 {
    return inner_fn_call_arg_non_const_context(param);
}
const fn inner_fn_call_arg_non_const_context(param: const i32) -> i32 {
    return param;
}

// =========================| Unary operator operand |=========================

const _UNARY_OPERAND = -not_const_value;

// =========================| Binary operator operands |=========================

const _BINARY_OPERAND = not_const_value + not_const_value;
