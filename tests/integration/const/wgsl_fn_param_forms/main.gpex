// Test all forms of function parameters in constant context (must be correctly transpiled).

// =========================| Copy |=========================

const _RESULT_COPY = copy_param(1); // expected: 1
const fn copy_param(param: i32) -> i32 {
    return param;
}

// =========================| Constant |=========================

const _RESULT_CONST = const_param(2); // expected: 2
const fn const_param(param: const i32) -> i32 {
    return param;
}

// =========================| Wildcard type |=========================

const _RESULT_WILDCARD_1 = wildcard_param(3u); // expected: 3u
const _RESULT_WILDCARD_2 = wildcard_param(4.0); // expected: 4.0
const fn wildcard_param(param: ?) -> typeof(param) {
    return param;
}

// =========================| Constant wildcard type |=========================

const _RESULT_CONST_WILDCARD_1 = const_wildcard_param(5u); // expected: 5u
const _RESULT_CONST_WILDCARD_2 = const_wildcard_param(6.0); // expected: 6.0
const fn const_wildcard_param(param: const ?) -> typeof(param) {
    return param;
}

// =========================| Constant wildcard type reference |=========================

const _RESULT_CONST_WILDCARD_TYPE = sizeof(type_of(1)); // expected: 4u
const fn type_of(value: const ?) -> typeref {
    return typeof(value);
}

// =========================| Dependent wildcard type |=========================

const _RESULT_DEPENDENT_TYPE_1 = dependent_type(7u, 8u); // expected: 8u
const _RESULT_DEPENDENT_TYPE_2 = dependent_type(9.0, 10.0); // expected: 10.0
const fn dependent_type(param: ?, value: typeof(param)) -> typeof(param) {
    return value;
}
