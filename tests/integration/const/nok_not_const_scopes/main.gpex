// Test not constant expressions in all constant scopes (must generate errors).

var not_const_value = 0;
const fn const_fn(param: i32) -> i32 {
    return param;
}
const fn __neg__(param: i32) -> i32 {
    return param;
}

// =========================| Global scope |=========================

const _GLOBAL_SCOPE = not_const_value;

// =========================| Function arg scope |=========================

const _FN_ARG_SCOPE = const_fn(not_const_value);

// =========================| Unary operator operand scope |=========================

const _UNARY_OPERAND_SCOPE = -not_const_value;

// =========================| Function parameter type scope |=========================

fn _fn_param_type_scope(param: not_const_value) -> i32 {
    return param;
}

// =========================| Function return type scope |=========================

fn _fn_return_type_scope(param: i32) -> not_const_value {
    return param;
}

// =========================| Function body root scope |=========================

const fn _fn_body_root_scope() -> i32 {
    return not_const_value;
}
