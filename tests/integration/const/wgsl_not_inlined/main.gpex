const fn called_fn_with_arg_constness_mix(_param1: i32, _param2: i32) -> i32 {
    return 1;
}

// =========================| Not constant function called with constant arguments |=========================

var _result_not_const_fn_with_const_args = not_const_fn(0, 0); // expected: 2
fn not_const_fn(_param1: i32, _param2: i32) -> i32 {
    return 2;
}
