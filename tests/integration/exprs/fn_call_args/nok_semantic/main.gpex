// Test invalid semantic for function call arguments.

var not_const_var = 0;

// ===== Not constant in constant context =====

const _NOT_CONST_IN_CONST_CONTEXT = const_fn(not_const_var);
const fn const_fn(param: i32) -> i32 {
    return param;
}

// ===== Not constant for constant parameter =====

var _not_const_var = const_params(0, not_const_var, 0);
fn _not_const_param(param: i32) -> i32 {
    return const_params(0, param, 0);
}
fn const_params(_param1: const i32, param2: const i32, _param3: const i32) -> i32 {
    return param2;
}

var _not_const_wildcard = const_wildcard_param(not_const_var);
fn const_wildcard_param(param: const ?) -> typeof(param) {
    return param;
}
