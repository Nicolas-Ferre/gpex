// Test WGSL inlining for function call arguments.

// ===== Parameter in constant function =====

const _RESULT_FN_PARAM = fn_with_returned_call_arg(1); // expected: 1
const fn fn_with_returned_call_arg(param: i32) -> i32 {
    return called_fn(param);
}
const fn called_fn(param: i32) -> i32 {
    return param;
}
