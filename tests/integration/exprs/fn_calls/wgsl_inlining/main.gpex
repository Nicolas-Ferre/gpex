// Test WGSL inlining for function call expressions.

const fn fn_(param: i32) -> i32 {
    return param;
}

// ===== Standard form constness =====

const _RESULT_STANDARD_CONSTNESS = fn_(1); // expected: 1

// ===== Uniform form constness =====

const _RESULT_UNIFORM_CONSTNESS = 2.fn_(); // expected: 2
