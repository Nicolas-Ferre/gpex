// Test invalid operator function definitions (must generate errors).

// =========================| Unary with less than one parameter |=========================

fn __neg__() -> i32 {
    return 0;
}
fn __not__() -> i32 {
    return 0;
}

// =========================| Unary with more than one parameter |=========================

fn __neg__(_param1: i32, _param2: i32) -> i32 {
    return 0;
}
fn __not__(_param1: i32, _param2: i32) -> i32 {
    return 0;
}

// =========================| Unary with no return type |=========================

fn __neg__(param: i32) {
    return param;
}
fn __not__(param: i32) {
    return param;
}

