// Test all forms of function definitions (must be correctly transpiled).

// =========================| Parametrized type |=========================

var _result1_parametrized_type = parametrized_type(i32, 1); // expected: 1
var _result2_parametrized_type = parametrized_type(u32, 2u); // expected: 2u
fn parametrized_type(type_: const typeref, param: type_) -> type_ {
    return param;
}

// =========================| Forwarded wildcard type |=========================

var _result1_forwarded_wildcard_type = forward_wildcard(3u); // expected: 3u
var _result2_forwarded_wildcard_type = forward_wildcard(4.0); // expected: 4.0
fn forward_wildcard(param: ?) -> typeof(param) {
    return wildcard(param);
}
fn wildcard(param: ?) -> typeof(param) {
    return param;
}

// =========================| Forwarded const to not const wildcard type |=========================

var _result1_forwarded_const_to_not_const_wildcard_type = forward_const_wildcard(1u); // expected: 1u
var _result2_forwarded_const_to_not_const_wildcard_type = forward_const_wildcard(2.0); // expected: 2.0
fn forward_const_wildcard(value: const ?) -> typeof(value) {
    return not_const_wildcard(value);
}
fn not_const_wildcard(value: ?) -> typeof(value) {
    return value;
}
