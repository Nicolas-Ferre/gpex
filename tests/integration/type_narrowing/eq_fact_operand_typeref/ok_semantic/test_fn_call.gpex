const fn identity(type_: const typeref) -> typeref {
    return type_;
}

fn fn_(type_: const typeref, value: ?) -> bool {
    return type_ == i32 && typeof(value) == identity(type_) && value == 1;
}

var _result_i32_one = fn_(i32, 1); // expected: true
var _result_i32_not_one = fn_(i32, 2); // expected: false
var _result_not_i32 = fn_(u32, 1u); // expected: false
