fn called(_param: ?) -> bool {
    return false;
}

fn called(param: i32) -> bool {
    return param == 1;
}

fn fn_(param: ?) -> bool {
    return typeof(param) != i32 || called(param);
}

var _result_i32_one = fn_(1); // expected: true
var _result_i32_not_one = fn_(2); // expected: false
var _result_not_i32 = fn_(1u); // expected: true
