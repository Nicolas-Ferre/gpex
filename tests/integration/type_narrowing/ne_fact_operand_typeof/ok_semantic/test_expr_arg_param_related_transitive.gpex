fn fn_(left: ?, middle: typeof(left), right: typeof(middle)) -> bool {
    return typeof(right) != i32 || left + middle + right == 6;
}

var _result_i32_six = fn_(1, 2, 3); // expected: true
var _result_i32_not_six = fn_(1, 2, 4); // expected: false
var _result_not_i32 = fn_(1u, 2u, 3u); // expected: true
