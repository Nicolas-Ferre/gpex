fn fn_(type_: const typeref, left: type_, middle: ?, right: ?) -> bool {
    return type_ == typeof(middle)
        && typeof(middle) == typeof(right)
        && type_ == i32
        && left + middle + right == 6;
}

var _result_i32_six = fn_(i32, 1, 2, 3); // expected: true
var _result_i32_not_six = fn_(i32, 1, 2, 4); // expected: false
var _result_not_i32 = fn_(u32, 1u, 2u, 3u); // expected: false
