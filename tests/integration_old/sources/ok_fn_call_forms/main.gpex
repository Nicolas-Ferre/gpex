// Test function sources with all call expression forms (must be found).

// =========================| Function call without arguments |=========================

var _result_fn_call_no_arg = fn_no_param(); // expected: 1
fn fn_no_param() -> i32 {
    return 1;
}

// =========================| Function call with arguments |=========================

var _result_fn_call_args = fn_params(2, 0u); // expected: 2
fn fn_params(param1: i32, _param2: u32) -> i32 {
    return param1;
}

// =========================| Uniform function call with one argument |=========================

var _result_uniform_fn_call_one_arg = 3.fn_uniform_one_param(); // expected: 3
fn fn_uniform_one_param(param: i32) -> i32 {
    return param;
}

// =========================| Negative uniform function call |=========================

const NOT_LITERAL = 0;
var _result_neg_uniform_fn_call_one_arg = -NOT_LITERAL.fn_neg_uniform(); // expected: -3
fn fn_neg_uniform(_param: i32) -> i32 {
    return 3;
}
fn __neg__(_param: i32) -> i32 {
    return -3;
}

// =========================| Uniform function call with many arguments |=========================

var _result_uniform_fn_call_many_arg = 0.fn_uniform_many_params(4); // expected: 4
fn fn_uniform_many_params(_param1: i32, param2: i32) -> i32 {
    return param2;
}

// =========================| Uniform function call chain |=========================

var _result_uniform_fn_call_chain = 0.fn_uniform_chain(0).fn_uniform_chain(5); // expected: 5
fn fn_uniform_chain(_param1: i32, param2: i32) -> i32 {
    return param2;
}

// =========================| Unary operator |=========================

var _result_unary_neg = -true; // expected: true
fn __neg__(param: bool) -> bool {
    return param;
}

var _result_unary_not = !5; // expected: 5
fn __not__(param: i32) -> i32 {
    return param;
}

// =========================| Binary operator |=========================

var _result_binary_add = 4u + 0.0; // expected: 4u
fn __add__(param1: u32, _param2: f32) -> u32 {
    return param1;
}

var _result_binary_sub = 5u - 0.0; // expected: 5u
fn __sub__(param1: u32, _param2: f32) -> u32 {
    return param1;
}

var _result_binary_mul = 6u * 0.0; // expected: 6u
fn __mul__(param1: u32, _param2: f32) -> u32 {
    return param1;
}

var _result_binary_div = 7u / 0.0; // expected: 7u
fn __div__(param1: u32, _param2: f32) -> u32 {
    return param1;
}

var _result_binary_mod = 8u % 0.0; // expected: 8u
fn __mod__(param1: u32, _param2: f32) -> u32 {
    return param1;
}

var _result_binary_eq = 9u == 0.0; // expected: 9u
fn __eq__(param1: u32, _param2: f32) -> u32 {
    return param1;
}

var _result_binary_ne = 10u != 0.0; // expected: 10u
fn __ne__(param1: u32, _param2: f32) -> u32 {
    return param1;
}

var _result_binary_lt = 11u < 0.0; // expected: 11u
fn __lt__(param1: u32, _param2: f32) -> u32 {
    return param1;
}

var _result_binary_le = 12u <= 0.0; // expected: 12u
fn __le__(param1: u32, _param2: f32) -> u32 {
    return param1;
}

var _result_binary_gt = 13u > 0.0; // expected: 13u
fn __gt__(param1: u32, _param2: f32) -> u32 {
    return param1;
}

var _result_binary_ge = 14u >= 0.0; // expected: 14u
fn __ge__(param1: u32, _param2: f32) -> u32 {
    return param1;
}

var _result_binary_and = 15u && 0.0; // expected: 15u
fn __and__(param1: u32, _param2: f32) -> u32 {
    return param1;
}

var _result_binary_or = 16u || 0.0; // expected: 16u
fn __or__(param1: u32, _param2: f32) -> u32 {
    return param1;
