// =========================| Binary operator chain |=========================

var _result_binary_chain = true + false * true; // expected: true
fn __add__(_param1: bool, _param2: bool) -> bool {
    return true;
}
fn __mul__(_param1: bool, _param2: bool) -> bool {
    return false;
}
