// Test function sources before all possible scopes (must be found).

const fn source() -> typeref {
    return i32;
}

const fn requirement() -> bool {
    return true;
}

// =========================| Global |=========================

var _result_global = source(); // expected: i32

// =========================| Function parameter requirement |=========================

var _result_fn_param_requirement = fn_param_requirement(2); // expected: 2
fn fn_param_requirement(param: i32 require requirement()) -> i32 {
    return param;
}

// =========================| Function return type |=========================

var _result_fn_return_type = fn_return_type(3); // expected: 3
fn fn_return_type(param: i32) -> source() {
    return param;
}
