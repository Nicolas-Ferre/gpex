// Test all forms of literals (must be correctly transpiled and calculated).

// =========================| `bool` literal |=========================

var _bool_false = false; // expected: false
var _bool_true = true; // expected: true

// =========================| `f32` literal |=========================

var _f32_min = -340_282_347_000_000_000_000_000_000_000_000_000_000.0; // expected: -340282350000000000000000000000000000000.0
var _f32_zero = 0.0; // expected: 0.0
var _f32_near_zero = 0.00000000000000000000001; // expected: 0.00000000000000000000001
var _f32_max = 340_282_347_000_000_000_000_000_000_000_000_000_000.0; // expected: 340282350000000000000000000000000000000.0

// =========================| `i32` literal |=========================

var _i32_min = -2_147_483_648; // expected: -2147483648
var _i32_zero = 0; // expected: 0
var _i32_max = 2_147_483_647; // expected: 2147483647

// =========================| `u32` literal |=========================

var _u32_zero = 0u; // expected: 0u
var _u32_max = 4_294_967_295u; // expected: 4294967295u
