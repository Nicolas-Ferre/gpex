// Test all forms of constant expressions (must be transpiled inline).

// =========================| Global constant reference |=========================

const CONST = 1;
const _RESULT_GLOBAL_CONST = CONST; // expected: 1

// =========================| `compilerimpl` type reference |=========================

const _COMPILERIMPL_TYPE = i32; // expected: i32

// =========================| Function parameter reference |=========================

const _RESULT_FN_PARAM = fn_returning_param(2); // expected: 2
const fn fn_returning_param(param: i32) -> i32 {
    return param;
}

// =========================| Function constant parameter reference |=========================

var _result_const_fn_param = outer_const_param(7); // expected: 7
fn outer_const_param(param: const i32) -> i32 {
    return inner_const_param(param);
}
fn inner_const_param(param: const i32) -> i32 {
    return param;
}

// =========================| Function call |=========================

const _RESULT_FN_CALL = called_fn(); // expected: 3
const fn called_fn() -> i32 {
    return 3;
}

// =========================| Uniform function call |=========================

const _RESULT_FN_UNIFORM_CALL = 4.uniform_called_fn(); // expected: 4
const fn uniform_called_fn(param: i32) -> i32 {
    return param;
}

// =========================| Unary operator |=========================

const _RESULT_UNARY = !0; // expected: 5
const fn __not__(_param: i32) -> i32 {
    return 5;
}

// =========================| Binary operator |=========================

const _RESULT_BINARY = true + false; // expected: 6
const fn __add__(_param1: bool, _param2: bool) -> i32 {
    return 6;
}
