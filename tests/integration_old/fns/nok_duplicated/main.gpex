// Test duplicated function signatures (must generate warnings).

pub import imported;

// =========================| Concrete types |=========================

fn _concrete(_value: i32) -> i32 {
    return 0;
}
fn _concrete(_other: i32) -> i32 {
    return 0;
}

// =========================| `typeof` concrete type |=========================

fn _typeof_concrete(_value: typeof(0)) -> i32 {
    return 0;
}
fn _typeof_concrete(_value: i32) -> i32 {
    return 0;
}

// =========================| Wildcards |=========================

fn _wildcard(value: ?) -> typeof(value) {
    return value;
}
fn _wildcard(other: ?) -> typeof(other) {
    return other;
}

// =========================| `typeof` wildcard |=========================

fn _typeof_wildcard(value: ?, copy: typeof(value)) -> typeof(value) {
    return copy;
}
fn _typeof_wildcard(other: ?, other_copy: typeof(other)) -> typeof(other) {
    return other_copy;
}

// =========================| Type parameters |=========================

fn _type_param(type_: const typeref, value: type_) -> type_ {
    return value;
}
fn _type_param(other_type: const typeref, other_value: other_type) -> other_type {
    return other_value;
}

// =========================| `typeof` type parameter |=========================

fn _typeof_param(type_: const typeref, value: type_, copy: typeof(value)) -> type_ {
    return copy;
}
fn _typeof_param(other_type: const typeref, other_value: other_type, other_copy: typeof(other_value)) -> other_type {
    return other_copy;
}

// =========================| More than two duplications |=========================

fn _previous_matching(value: i32) -> i32 {
    return value;
}
fn _previous_matching(value: i32) -> i32 {
    return value;
}
fn _previous_matching(value: i32) -> i32 {
    return value;
}

// =========================| Ignored qualifiers, names and returns |=========================

pub const fn attributes(_value: const i32) -> i32 {
    return 0;
}
fn attributes(_other: i32) -> u32 {
    return 0u;
}
var _attributes_usage = attributes(0);

// =========================| Ignored imported definitions |=========================

fn imported(value: i32) -> i32 {
    return value;
}
var _imported_usage = imported(0);

// =========================| Ignored wildcard and concrete types |=========================

fn _wildcard_concrete(input: ?) -> typeof(input) {
    return input;
}
fn _wildcard_concrete(input: i32) -> i32 {
    return input;
}

// =========================| Different parameter positions |=========================

fn _different_param_positions(type1: const typeref, type2: const typeref, value1: type1, _value2: type2) -> type1 {
    return value1;
}
fn _different_param_positions(type1: const typeref, type2: const typeref, value1: type2, _value2: type1) -> type2 {
    return value1;
}

// =========================| Different `typeof` wildcards |=========================

fn _different_wildcard_positions(param1: ?, param2: ?, value1: typeof(param1), _value2: typeof(param2)) -> typeof(param1) {
    return value1;
}
fn _different_wildcard_positions(param1: ?, param2: ?, value1: typeof(param2), _value2: typeof(param1)) -> typeof(param2) {
    return value1;
}
