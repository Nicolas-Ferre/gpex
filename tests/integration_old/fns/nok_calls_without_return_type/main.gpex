// Test calls without function type as expressions (must generate errors).

fn fn_with_no_return(param: i32) {
    param = 0;
}

// =========================| Directly called |=========================

var _result_direct = fn_with_no_return(0);


// =========================| Called as function call argument |=========================

repeat fn_with_no_return(fn_with_no_return(0));

// =========================| typeof() on expression without return type  |=========================

var _result_typeof_no_return_type = fn_typeof_no_return_type(0);
fn fn_typeof_no_return_type(value: typeof(fn_with_no_return(0))) -> i32 {
    return value;
}
