// Test type comparison for all possible type kinds (must generate errors).

// ====================| Returned type reference as type parameter |====================

fn _fn_type_ref_type_param(param: const typeref) -> param {
    return i32;
}

// ====================| Returned type parameter as other type parameter |====================

fn _fn_type_param_type_param(param1: const typeref, param2: const typeref, value: param1) -> param2 {
    return value;
}

// ====================| Returned type parameter as type reference |====================

fn _fn_type_param_type_ref(param: const typeref, value: param) -> i32 {
    return value;
}

// ====================| Returned type parameter through function as type reference |====================

fn _fn_type_param_through_fn_type_ref(param: const typeref, value: type_param_fn(param)) -> i32 {
    return value;
}
const fn type_param_fn(other_name: const typeref) -> typeref {
    return other_name;
}

// ====================| Returned wildcard type as type reference |====================

fn _fn_wildcard_type_ref(param: ?) -> i32 {
    return param;
}

// ====================| Returned type reference as wildcard type |====================

fn _fn_type_ref_wildcard(param: ?, value: i32) -> typeof(param) {
    return value;
}

// ====================| Returned wildcard type as type parameter |====================

fn _fn_wildcard_type_param(type_: const typeref, param: ?) -> type_ {
    return param;
}

// ====================| Returned type parameter as wildcard type |====================

fn _fn_type_param_wildcard(type_: const typeref, param: ?, value: type_) -> typeof(param) {
    return value;
}

// ====================| Returned wildcard type as other wildcard type |====================

fn _fn_wildcard_other_wildcard(param1: ?, param2: ?) -> typeof(param2) {
    return param1;
}
