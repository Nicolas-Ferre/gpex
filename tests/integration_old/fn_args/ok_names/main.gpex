// Test optional function call argument names (must preserve positional behavior).

fn add(left: i32, right: i32) -> i32 {
    return left + right;
}

// =============================| All arguments named |=============================

var _result_all_named = add(left: 1, right: 2); // expected: 3

// ==========================| Named and unnamed arguments |==========================

var _result_named_first = add(left: 3, 4); // expected: 7
var _result_named_last = add(5, right: 6); // expected: 11

// =======================| Underscore-prefixed parameter name |=======================

var _result_underscore_name = select(_unused: 7, result: 8); // expected: 8
fn select(_unused: i32, result: i32) -> i32 {
    return result;
}

// ==============================| Uniform function call argument |==============================

var _result_uniform_call = 10.add(right: 11); // expected: 21
