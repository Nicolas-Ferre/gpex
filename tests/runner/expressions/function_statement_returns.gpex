// test all type of expressions in return statements (expressions tested more in details in variables.gpex)

const CONSTANT = 123;
var variable = 456;
fn function() -> i32 {
    return 123;
}

fn i32_literal() -> i32 {
    return 123;
}
var _i32_literal = i32_literal(); // expected: 123
fn u32_literal() -> u32 {
    return 123u;
}
var _u32_literal = u32_literal(); // expected: 123u
fn f32_literal() -> f32 {
    return 123.456;
}
var _f32_literal = f32_literal(); // expected: 123.456
fn bool_true() -> bool {
    return true;
}
var _bool_true = bool_true(); // expected: true
fn bool_false() -> bool {
    return false;
}
var _bool_false = bool_false(); // expected: false
fn typeref_native() -> typeref {
    return i32;
}
var _typeref_native = typeref_native(); // expected: i32

fn identifier_constant() -> i32 {
    return CONSTANT;
}
var _identifier_constant = identifier_constant(); // expected: 123
fn identifier_variable() -> i32 {
    return variable;
}
var _identifier_variable = identifier_variable(); // expected: 456
fn function_call_with_no_parameter() -> i32 {
    return function();
}
var _function_call_with_no_parameter = function_call_with_no_parameter(); // expected: 123
