// test all type of expressions as constant values (expressions tested more in details in variables.gpex)

const CONSTANT = 123;

const fn function() -> i32 {
    return 123;
}

const I32_LITERAL = 123;
var _i32_literal = I32_LITERAL; // expected: 123
const U32_LITERAL = 123u;
var _u32_literal = U32_LITERAL; // expected: 123u
const F32_LITERAL = 123.456;
var _f32_literal_min = F32_LITERAL; // expected: 123.456
const BOOL_TRUE = true;
var _bool_true = BOOL_TRUE; // expected: true
const BOOL_FALSE = false;
var _bool_false = BOOL_FALSE; // expected: false
const TYPEREF_NATIVE = i32;
var _typeref_native = TYPEREF_NATIVE; // expected: i32

const IDENTIFIER_CONSTANT = CONSTANT;
var _identifier_constant = IDENTIFIER_CONSTANT; // expected: 123
const FUNCTION_CALL = function();
var _function_call = FUNCTION_CALL; // expected: 123
