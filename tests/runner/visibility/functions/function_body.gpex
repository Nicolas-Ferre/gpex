// test visibility of functions from expressions in function bodies

fn function_before() -> i32 {
    return 1;
}

fn call_function_before() -> i32 {
    return function_before();
}

fn call_function_after() -> i32 {
    return function_after();
}

var _function_before = call_function_before(); // expected: 1
var _function_after = call_function_after(); // expected: 2

fn function_after() -> i32 {
    return 2;
}
