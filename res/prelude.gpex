/// A reference to a type.
///
/// # Examples
///
/// ```gpex
/// const Integer = i32; // a type alias of type `typeref`
/// ```
pub struct typeref = compilerimpl {}

/// A 32-bit signed integer.
///
/// # Examples
///
/// ```gpex
/// var zero = 0;
/// var positive = 123;
/// var negative = -123;
/// ```
pub struct i32 = compilerimpl {}

/// A 32-bit unsigned integer.
///
/// # Examples
///
/// ```gpex
/// var zero = 0u;
/// var positive = 123u;
/// ```
pub struct u32 = compilerimpl {}

/// A 32-bit floating-point number.
///
/// # Examples
///
/// ```gpex
/// var zero = 0.0;
/// var positive = 123.456;
/// var negative = -123.456;
/// ```
pub struct f32 = compilerimpl {}

/// A boolean value.
///
/// # Examples
///
/// ```gpex
/// var true_value = true;
/// var false_value = false;
/// ```
pub struct bool = compilerimpl {}

/// Adds two `i32` values.
///
/// # Examples
///
/// ```gpex
/// var value = 1 + 2;
/// ```
pub const fn __add__(left: i32, right: i32) -> i32 = compilerimpl;

/// Returns the type of a value.
///
/// # Examples
///
/// ```gpex
/// var value = 1;
/// const ValueType = typeof(value); // i32
/// ```
pub const fn typeof(value: ?) -> typeref = compilerimpl;

/// Returns the size in bytes of a type.
///
/// # Examples
///
/// ```gpex
/// const I32_SIZE = sizeof(i32); // 4u
/// ```
pub const fn sizeof(type_: const typeref) -> u32 = compilerimpl;
